# Start in simulation. Never enable live trading until tested with your account.
LIVE_TRADING_ENABLED=false
NEO_ENVIRONMENT=prod
# Keep API login and order requests on IPv4 when your Kotak whitelist is IPv4.
# A session must be created from the same public IP used to place orders.
NEO_FORCE_IPV4=true
# Required only for Kotak Neo login. Store secrets locally; do not commit .env.
NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=

# Chrome extension -> local bridge. Copy this same random value into extension/bridge-config.js.
# Generate a new value before first use, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=replace-with-a-long-random-secret

DATABASE_PATH=./data/neo_pip.sqlite3

# Optional phone access from the same trusted Wi-Fi. Leave disabled by default.
# Set a long random secret when enabling; the app asks for it on the phone and stores it in an HttpOnly cookie.
LAN_ACCESS_ENABLED=false
LAN_ACCESS_TOKEN=

# Transactional Email (OTP verification, Welcome emails, Password reset)
# Free options: Gmail App Password (~500/day), Brevo Free API (300/day), or custom HTTPS relay
PUBLIC_APP_URL=https://neo-pip-terminal.vercel.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
EXTRA_TRUSTED_EMAIL_DOMAINS=
