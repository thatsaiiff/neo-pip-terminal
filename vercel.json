{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "app/static/index.html", "use": "@vercel/static" },
    { "src": "app/static/styles.css", "use": "@vercel/static" },
    { "src": "app/static/app.js", "use": "@vercel/static" },
    { "src": "app/static/chart.html", "use": "@vercel/static" },
    { "src": "app/static/chart.css", "use": "@vercel/static" },
    { "src": "app/static/chart.js", "use": "@vercel/static" },
    { "src": "app/static/lightweight-charts.js", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://92.4.87.82:8000/api/:path*" },
    { "source": "/chart", "destination": "/app/static/chart.html" },
    { "source": "/ticket", "destination": "/app/static/index.html" },
    { "source": "/", "destination": "/app/static/index.html" },
    { "source": "/static/:path*", "destination": "/app/static/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' http://92.4.87.82:8000 https://neo-pip-backend-production.up.railway.app; frame-src 'self' https://s.tradingview.com https://www.tradingview.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ]
}
